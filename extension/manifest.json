{
  "manifest_version": 3,
  "name": "EGFULFILL — Etsy address sync",
  "version": "0.1.1",
  "description": "Send buyer addresses from your own Etsy Shop Manager page to EGFULFILL, so your orders can be labelled.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.etsy.com/your/orders/*",
    "https://app.egful.store/*",
    "https://api.egful.store/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "EGFULFILL address sync"
  }
}
