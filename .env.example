# Copy to ".env" on the VPS and fill in real values (this file is git-ignored).
DB_PASSWORD=use-a-long-random-password
JWT_SECRET=use-a-long-random-secret-string
# In production set this to your site origin, e.g. https://egful.store
CORS_ORIGIN=*
APP_URL=https://egful.store

# ── Etsy ──────────────────────────────────────────────────────────────────────
# Keystring is public (defaulted in docker-compose). Set the shared secret to
# enable API calls + webhook signature verification.
# ETSY_KEYSTRING=your-app-keystring
# ETSY_SHARED_SECRET=your-app-shared-secret

# ── TikTok Shop ───────────────────────────────────────────────────────────────
# App key + app secret + service_id from the TikTok Shop Partner Center. Register
# the app's authorization callback URL as https://egful.store/oauth-callback.html
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# ── Shopify ───────────────────────────────────────────────────────────────────
# Client ID + Client secret from the Shopify app (Dev Dashboard). Set the app's
# redirect URL to https://egful.store/oauth-callback.html and scopes to match below.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_SCOPES=read_orders,write_orders,read_products

# ── S&S Activewear (blanks supplier) ──────────────────────────────────────────
# REST v2 uses HTTP Basic: account number = username, API key = password.
# Both are required. Catalog + inventory sync powers the factory "New In" tab.
SS_ACCOUNT_NUMBER=
SS_API_KEY=
SS_API_BASE=https://api.ssactivewear.com/v2

# ── Otto Cap (headwear supplier) — OTTO CAP's proprietary API ──────────────────
# OAuth2 PASSWORD grant: Basic auth header = base64(CLIENT_ID:CLIENT_SECRET); token POST to
# {API_BASE}/authenticate/token/ with form body username+password+grant_type=password → Bearer.
# Sandbox first (place 3+ test orders, then email api@ottocap.com → they issue live creds).
#   Sandbox base: https://sandbox-api.ottocap.com   ·   Live base: https://connectivity.ottocap.com
# The Otto inventory/order "supplier" field is the CONSTANT 00ceb24d-9b6f-4ba1-91c8-aa375ab96651.
OTTOCAP_USERNAME=
OTTOCAP_PASSWORD=
OTTOCAP_CLIENT_ID=
OTTOCAP_CLIENT_SECRET=
OTTOCAP_API_BASE=https://sandbox-api.ottocap.com

# ── VietQR ────────────────────────────────────────────────────────────────────
# OUTBOUND (us → VietQR): mints the VA-backed top-up QR. Production base.
VIETQR_API_BASE=https://api.vietqr.org
VIETQR_API_USERNAME=customer-vso44906egfulfill-user26596
VIETQR_API_PASSWORD=your-approved-api-password
# INBOUND (VietQR → us): the Username/Password you registered on the VietQR portal;
# VietQR uses them (Basic Auth) before posting balance-change transactions to us.
VIETQR_USERNAME=your-portal-username
VIETQR_PASSWORD=your-portal-password
# Receiving (linked) bank account the VA-backed QR pays into — must match the
# account linked in your VietQR connection so callbacks fire.
VIETQR_BANK_CODE=BIDV
VIETQR_BANK_ACCOUNT=1231255899
VIETQR_ACCOUNT_NAME=PHAN MY LINH

# ── Stripe (card top-up) ──────────────────────────────────────────────────────
# Both keys from the SAME mode (test sk_test/pk_test, or live sk_live/pk_live).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ── PayPal (wallet top-up) ────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# ── Google Sign-In ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Google Sheets order import ────────────────────────────────────────────────
# Same Cloud project as Sign-In: enable the "Google Sheets API", make an API key
# (optionally restrict it to that API), and paste it here. Sellers paste a sheet
# link shared "Anyone with the link → Viewer" and we read its rows. Read-only.
GOOGLE_SHEETS_API_KEY=
# Optional: a master template sheet sellers copy. Use the /copy share link, e.g.
# https://docs.google.com/spreadsheets/d/<ID>/copy  (leave blank to let sellers
# build one from the in-app "Create in Google Sheets" button instead).
SHEETS_TEMPLATE_URL=
# Optional: a Google service account JSON key (paste the WHOLE downloaded file on
# one line, or base64 it). With this set, the server can auto-CREATE a ready-filled
# Google Sheet for sellers (needs Google Sheets API + Google Drive API enabled).
# Verify it with: GET /api/sheets/diag (signed in). Leave blank to disable.
GOOGLE_SERVICE_ACCOUNT=

# ── USPS (labels) ─────────────────────────────────────────────────────────────
# Defaults to the TEM test base; set USPS_BASE=https://apis.usps.com to go live.
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=
USPS_BASE=https://apis-tem.usps.com
USPS_CRID=
USPS_MID=
USPS_ACCOUNT_NUMBER=
USPS_ACCOUNT_TYPE=EPS
# USPS_MANIFEST_MID=    # optional; defaults to MID
# USPS_SCOPE=           # optional; request specific scopes once USPS grants them
# USPS_MOCK=1           # optional; return a sample label to test the flow

# ── Shipping aggregators (EasyPost / Shippo) ──────────────────────────────────
# Discounted USPS + UPS labels via API — no USPS EPS/scope approval needed.
# Set either or both; if both, rates from both merge and sort cheapest-first.
# Use test keys first (EZTK… / shippo_test_…), then live (EZAK… / shippo_live_…).
EASYPOST_API_KEY=
SHIPPO_API_TOKEN=

# ── Password-reset email (optional) ───────────────────────────────────────────
# Leave SMTP_HOST blank to keep resets admin-mediated only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Inbound email → order addresses ───────────────────────────────────────────
# Etsy withholds buyer addresses from the API but includes them in the seller's
# "You made a sale!" email. Sellers auto-forward those to an inbound-email provider
# (Mailgun Routes / SendGrid Inbound Parse / Postmark / CloudMailin) pointed at
#   POST https://egful.store/api/mail/etsy-sale?key=<MAIL_INGEST_SECRET>
# Leave blank to disable ingestion entirely (the endpoint 503s).
MAIL_INGEST_SECRET=
