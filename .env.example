# Copy to ".env" on the VPS and fill in real values (this file is git-ignored).
DB_PASSWORD=use-a-long-random-password
JWT_SECRET=use-a-long-random-secret-string
# In production set this to your site origin, e.g. https://your-domain.com
CORS_ORIGIN=*
# Etsy integration. Keystring is public (defaulted in docker-compose). Only set
# the shared secret here later if you add webhook signature verification.
# ETSY_KEYSTRING=your-app-keystring
# ETSY_SHARED_SECRET=your-app-shared-secret
