{
  "expo": {
    "name": "EGFUL",
    "slug": "egful",
    "scheme": "egful",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "store.egful.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "store.egful.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "apiBase": "https://api.egful.store"
    },
    "icon": "./assets/icon.png"
  }
}
