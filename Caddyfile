# Replace `your-domain.com` with your real domain (point its DNS A-record at the
# VPS IP) and Caddy fetches a free HTTPS cert automatically.
# No domain yet? Use `:80` instead of the domain line to test over plain HTTP.

# Canonical host is egful.store. Redirect www → non-www so the app, the OAuth popup,
# and the OAuth redirect_uri all live on ONE origin. A www/non-www split silently
# breaks the Etsy/TikTok connect flow: the popup stashes your login token in one
# origin's localStorage, then the provider redirects back to the OTHER origin where
# that token doesn't exist → "You're not signed in to EGFULFILL."
www.egful.store {
	redir https://egful.store{uri} permanent
}

egful.store {
	encode gzip

	# API → the Node app
	handle /api/* {
		reverse_proxy api:3000
	}

	# VietQR balance-change callbacks (server-to-server: token_generate + transaction-sync)
	handle /vqr/* {
		reverse_proxy api:3000
	}

	# SECURITY: the static root is the whole repo dir, so secrets/source must be blocked
	# from the web. Anything matching here is 404'd before file_server can serve it —
	# .env, .git, server source, compose, package files, node_modules, etc.
	@hidden path /.env* /.git /.git/* /.gitignore /.claude* /.dockerignore /server /server/* /node_modules/* /docker-compose.yml /docker-compose.yaml /Caddyfile /package.json /package-lock.json /agents/* /rules/* /memory/*
	handle @hidden {
		respond 404
	}

	# Everything else → the static frontend (clean URLs: /orders → orders.html)
	handle {
		root * /srv
		try_files {path} {path}.html /index.html
		# Fonts + images rarely change and were being re-fetched every load under a blanket
		# no-cache — which re-swapped the Departure Mono font on EVERY page (a per-page
		# flash) and reloaded images slowly. Long-cache those; keep HTML/JS/CSS on no-cache
		# so a `git pull` deploy is still picked up immediately (cheap 304s).
		@assets path *.woff2 *.woff *.ttf *.otf *.jpg *.jpeg *.png *.webp *.gif *.svg *.ico
		@dynamic not path *.woff2 *.woff *.ttf *.otf *.jpg *.jpeg *.png *.webp *.gif *.svg *.ico
		header @assets Cache-Control "public, max-age=2592000"
		header @dynamic Cache-Control "no-cache"
		file_server
	}
}
