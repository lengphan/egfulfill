# Replace `your-domain.com` with your real domain (point its DNS A-record at the
# VPS IP) and Caddy fetches a free HTTPS cert automatically.
# No domain yet? Use `:80` instead of the domain line to test over plain HTTP.

egful.store, www.egful.store {
	encode gzip

	# API → the Node app
	handle /api/* {
		reverse_proxy api:3000
	}

	# VietQR balance-change callbacks (server-to-server: token_generate + transaction-sync)
	handle /vqr/* {
		reverse_proxy api:3000
	}

	# Everything else → the static frontend (clean URLs: /orders → orders.html)
	handle {
		root * /srv
		try_files {path} {path}.html /index.html
		# Force browsers to revalidate HTML/JS/CSS every load (cheap 304s) so a
		# `git pull` deploy is picked up immediately — no more stale cached eg-*.js
		# on one board while another board has the new build.
		header Cache-Control "no-cache"
		file_server
	}
}
